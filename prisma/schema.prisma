// StudyFlow database schema.
// Supabase Postgres: DATABASE_URL = pooler (6543), DIRECT_URL = direct (5432).

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum TaskType {
  ASSIGNMENT
  READING
  EXAM
  PRESENTATION
  PROJECT
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  SKIPPED
}

enum CourseStatus {
  ACTIVE
  ARCHIVED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(STUDENT)
  isActive     Boolean  @default(true)
  settings     Json? // per-user UI settings (notification toggles, profile extras, etc.)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courses        Course[]            @relation("StudentCourses")
  taughtCourses  Course[]            @relation("InstructorCourses")
  auditLogs      AuditLog[]
  preferences    StudentPreferences?
  courseRequests CourseRequest[]     @relation("StudentRequests")

  @@map("users")
}

// A student's request for the admin to add a course to the catalog.
model CourseRequest {
  id             String        @id @default(uuid())
  code           String
  title          String
  instructorName String?
  note           String?
  status         RequestStatus @default(PENDING)
  decidedById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  studentId String
  student   User   @relation("StudentRequests", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
  @@map("course_requests")
}

model StudentPreferences {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  availabilityGrid   Json? // 8 time-slots x 7 days of "free|class|work|blocked"
  maxStudyHours      Int      @default(6)
  focusTime          String   @default("Evening") // Morning | Evening | Late night
  minBreakMins       Int      @default(15)
  notifyBeforeBlocks Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("student_preferences")
}

model Course {
  id             String   @id @default(uuid())
  code           String
  title          String
  instructorName String?
  creditHours    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Student who owns/enrolled this course entry.
  userId String
  user   User   @relation("StudentCourses", fields: [userId], references: [id], onDelete: Cascade)

  // Optional link to the instructor account (powers the instructor dashboard).
  instructorId String?
  instructor   User?   @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: SetNull)

  tasks Task[]

  @@index([userId])
  @@index([instructorId])
  @@index([code])
  @@map("courses")
}

model Task {
  id          String     @id @default(uuid())
  title       String
  type        TaskType   @default(ASSIGNMENT)
  deadline    DateTime
  effortHours Float      @default(1)
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(NOT_STARTED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([deadline])
  @@index([status])
  @@map("tasks")
}

// Institution course catalog, managed by admins. Separate from a student's
// personal Course entries; enrollment counts are derived from those by code.
model CatalogCourse {
  id             String       @id @default(uuid())
  code           String       @unique
  title          String
  instructorName String?
  term           String       @default("Fall 2026")
  status         CourseStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("catalog_courses")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("audit_logs")
}
