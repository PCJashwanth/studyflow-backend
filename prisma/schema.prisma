// StudyFlow database schema.
// Supabase Postgres: DATABASE_URL = pooler (6543), DIRECT_URL = direct (5432).

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum TaskType {
  ASSIGNMENT
  READING
  EXAM
  PRESENTATION
  PROJECT
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  SKIPPED
}

enum CourseStatus {
  ACTIVE
  ARCHIVED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(STUDENT)
  isActive     Boolean  @default(true)
  settings     Json? // per-user UI settings (notification toggles, profile extras, etc.)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courses         Course[]            @relation("StudentCourses")
  taughtCourses   Course[]            @relation("InstructorCourses")
  auditLogs       AuditLog[]
  preferences     StudentPreferences?
  courseRequests  CourseRequest[]     @relation("StudentRequests")
  scheduleBlocks  ScheduleBlock[]
  catalogCourses  CatalogCourse[]     @relation("InstructorCatalog")
  assignments     Assignment[]        @relation("InstructorAssignments")
  otpCodes        OtpCode[]

  @@map("users")
}

// One-time login codes (email 2FA). Codes are stored hashed and single-use.
model OtpCode {
  id         String    @id @default(uuid())
  codeHash   String
  purpose    String    @default("LOGIN")
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otp_codes")
}

// A student's request for the admin to add a course to the catalog.
model CourseRequest {
  id             String        @id @default(uuid())
  code           String
  title          String
  instructorName String?
  note           String?
  status         RequestStatus @default(PENDING)
  decidedById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  studentId String
  student   User   @relation("StudentRequests", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
  @@map("course_requests")
}

model StudentPreferences {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  availabilityGrid   Json? // legacy 8x7 grid (kept for back-compat)
  availability       Json? // per-day free time ranges: { Mon: [{start,end}], ... }
  maxStudyHours      Int      @default(6)
  focusTime          String   @default("Evening") // Morning | Evening | Late night
  minBreakMins       Int      @default(15)
  notifyBeforeBlocks Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("student_preferences")
}

model Course {
  id             String   @id @default(uuid())
  code           String
  title          String
  instructorName String?
  creditHours    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Student who owns/enrolled this course entry.
  userId String
  user   User   @relation("StudentCourses", fields: [userId], references: [id], onDelete: Cascade)

  // Optional link to the instructor account (powers the instructor dashboard).
  instructorId String?
  instructor   User?   @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: SetNull)

  tasks Task[]

  @@index([userId])
  @@index([instructorId])
  @@index([code])
  @@map("courses")
}

model Task {
  id          String     @id @default(uuid())
  title       String
  type        TaskType   @default(ASSIGNMENT)
  deadline    DateTime
  effortHours Float      @default(1)
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(NOT_STARTED)
  // Added by a teammate (email deadline reminders) — kept in sync with the shared DB.
  reminderSentAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Set when this task came from an instructor-created assignment.
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  scheduleBlocks ScheduleBlock[]

  @@index([courseId])
  @@index([deadline])
  @@index([status])
  @@index([deadline, reminderSentAt])
  @@index([assignmentId])
  @@map("tasks")
}

enum BlockSource {
  AI
  RULE
  MANUAL
}

// A generated (or manual) study block on the student's calendar.
model ScheduleBlock {
  id        String      @id @default(uuid())
  title     String
  start     DateTime
  end       DateTime
  rationale String?
  source    BlockSource @default(AI)
  weekStart DateTime // Monday of the week this block belongs to (for regeneration)
  createdAt DateTime    @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, start])
  @@index([userId, weekStart])
  @@map("schedule_blocks")
}

// Institution course catalog, managed by admins. Separate from a student's
// personal Course entries; enrollment counts are derived from those by code.
model CatalogCourse {
  id             String       @id @default(uuid())
  code           String       @unique
  title          String
  instructorName String?
  term           String       @default("Fall 2026")
  status         CourseStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // The instructor account assigned to teach this course.
  instructorId String?
  instructor   User?   @relation("InstructorCatalog", fields: [instructorId], references: [id], onDelete: SetNull)

  @@index([instructorId])
  @@map("catalog_courses")
}

// An assignment an instructor creates for a catalog course. On creation it is
// fanned out as a Task to every enrolled student.
model Assignment {
  id          String   @id @default(uuid())
  code        String // catalog course code
  title       String
  type        TaskType @default(ASSIGNMENT)
  deadline    DateTime
  effortHours Float    @default(2)
  priority    Priority @default(MEDIUM)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  instructorId String
  instructor   User   @relation("InstructorAssignments", fields: [instructorId], references: [id], onDelete: Cascade)

  tasks Task[]

  @@index([code])
  @@index([instructorId])
  @@map("assignments")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("audit_logs")
}
