# ---- Server ----
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ---- Auth ----
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ---- Database (Supabase Postgres) ----
# App connection — use the POOLER host (port 6543, transaction mode).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations — use the DIRECT host (port 5432).
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- AI (Groq / Llama 3.3 70B) ----
# Optional: a rule-based fallback scheduler runs if this is missing.
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Email (Resend) — OTP 2FA + notifications ----
# Optional: without it, the OTP code is logged to the server (dev). Get a free key at https://resend.com
RESEND_API_KEY=re_your_key_here
RESEND_FROM=StudyFlow <onboarding@resend.dev>
