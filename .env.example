# ---- Server ----
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ---- Auth ----
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ---- Database (Supabase Postgres) ----
# App connection — use the POOLER host (port 6543, transaction mode).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations — use the DIRECT host (port 5432).
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- Notifications (all optional) ----
# Leave blank to print reminder emails to the console instead of sending them.
RESEND_API_KEY=
# Until you verify a domain, Resend only delivers to your own account email.
MAIL_FROM=StudyFlow <onboarding@resend.dev>
# Secret the scheduler sends. Generate one with: openssl rand -hex 32
CRON_SECRET=
# Hours before a deadline to send the reminder.
REMINDER_LEAD_HOURS=24
